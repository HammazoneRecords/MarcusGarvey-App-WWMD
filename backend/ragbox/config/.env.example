# Environment Configuration for RAGBox

# Gemini API Key (REQUIRED)
GEMINI_API_KEY="your_gemini_api_key_here"

# Citation Configuration
CITATION_EXPAND_MAX_LINES=500
CITATION_MAX_DISPLAY=8

# Encoding Configuration (Windows compatibility)
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# Database Path (optional, defaults to data/memory.db)
# DB_PATH="data/memory.db"

# Session Vault Path (optional, defaults to sessions/)
# SESSIONS_DIR="sessions/"
