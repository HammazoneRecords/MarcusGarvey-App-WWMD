# Whirlwind KB — Environment variables (copy to .env and fill; never commit .env)
# See docs/PRE_PUBLICATION_CHECKLIST.md and README for deployment.

# ---------- Backend (API server) ----------
# Required for Garvey Lens / chat (RAG uses Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: API host and port (default: 0.0.0.0:5050)
# ARK_API_HOST=0.0.0.0
# ARK_API_PORT=5050

# Production: comma-separated allowed frontend origins (e.g. https://whirlwind.example.com)
# Leave unset for development (allows all origins).
# CORS_ORIGINS=https://your-frontend-domain.com

# Optional: input length limits (defaults: 4000 situation, 2000 query)
# WWMD_SITUATION_MAX_LEN=4000
# CHAT_QUERY_MAX_LEN=2000

# ---------- Frontend (build-time only) ----------
# Set when building for production so the app calls your API URL.
# VITE_API_BASE_URL=https://api.your-domain.com
# Development uses Vite proxy; optional override:
# VITE_DEV_API=http://localhost:5050
